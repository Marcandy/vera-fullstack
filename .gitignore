# Repo-root ignores. The React app keeps its own .gitignore inside
# react-front-end-app/, but gitignore patterns only apply from the file's own
# directory downward, so anything sitting at this level has to be listed here
# too. That includes the private notes below, which must never be committed.

# Private notes and working files. Not part of the project.
CLAUDE.local.md
CLAUDE.local.archive.md
INTERVIEW-NOTES.md
currentIssue.md
plan.md
analysis.md
STANDUP-NOTES.md
presentation.md
presentation2.md
tech-review.md
reviewcode.jsx
.claude/
.agents/

# Local secrets. .env.example is the committed template and is safe to read;
# .env itself holds real values and never gets committed.
.env

# Node
node_modules/
dist/
dist-ssr/
*.local

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# IntelliJ
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/*
!.vscode/extensions.json

# Logs
logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
