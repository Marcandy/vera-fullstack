<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.vera</groupId>
	<artifactId>vera-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>vera-api</name>
	<description>Vera API: the backend behind the front end's service layer</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!--
			webmvc, not web. Boot 4 deprecates spring-boot-starter-web in favour
			of this one, which names the servlet stack outright instead of
			leaving "web" ambiguous between Spring MVC and WebFlux. The old
			artifact still resolves, so this is a rename to follow rather than a
			break to work around.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--
			Restarts the application when a class changes, so a code edit does
			not need a manual stop and start. optional=true stops it leaking
			onto the classpath of anything that depends on this project, and it
			disables itself in a packaged jar, so it never ships to production.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- runtime scope: the application compiles against JDBC, not against
		     the driver, so nothing in src/main should import it -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Boot 4 adds a test starter per slice, and Initializr now generates
			these two in place of the single spring-boot-starter-test, which
			still exists. Per slice means the test classpath carries what these
			layers actually need rather than every testing library at once.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
